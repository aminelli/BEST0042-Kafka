# Configurazione MySQL per Change Data Capture (CDC) con Debezium
# Questo file abilita il binary logging necessario per catturare i cambiamenti

[mysqld]
# Abilita il binary logging per CDC
log-bin=mysql-bin
binlog_format=ROW
binlog_row_image=FULL
expire_logs_days=10

# Server ID univoco (richiesto per la replicazione)
server-id=1

# Abilita GTID (Global Transaction Identifier) per tracciamento preciso
gtid_mode=ON
enforce_gtid_consistency=ON

# Performance settings
max_connections=200
innodb_buffer_pool_size=256M

# Character set
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

# Timezone
default-time-zone='+00:00'
